// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  username   String      @unique
  discordId  String      @unique
  fresh      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  characters Character[]
  interface  Interface?
}

type Interface {
  inventory  InventoryInterface?
  questMenu  QuestMenuInterface?
  skillsMenu SkillsMenuInterface?
}

type InventoryInterface {
  screen ScreenPosition
}

type QuestMenuInterface {
  screen ScreenPosition
}

type SkillsMenuInterface {
  screen ScreenPosition
}

type ScreenPosition {
  x Int
  y Int
  w Int
  h Int
}

model Character {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  name         String     @unique
  lastPosition Position
  rot          Float
  appearance   Appearance
  health       Float
  createdAt    DateTime   @default(now())
  inventory    Inventory
  equipment    Equipment
  questFacts   String[]
  skills       Skills
}

type Skills {
  woodcutting Skill
}

type Skill {
  experience Int @default(0)
}

type Inventory {
  items InventoryItem[]
  size  Int
}

type InventoryItem {
  slot Int
  data ItemData
}

type Equipment {
  mask      ItemData?
  glasses   ItemData?
  headwear  ItemData?
  earrings  ItemData?
  top       ItemData?
  shirt     ItemData?
  armor     ItemData?
  neckwear  ItemData?
  weapon    ItemData?
  ammo      ItemData?
  gloves    ItemData?
  lefthand  ItemData?
  pants     ItemData?
  righthand ItemData?
  backpack  ItemData?
  shoes     ItemData?
  phone     ItemData?
}

enum ItemType {
  FIREARM_WEAPON
  THROWABLE_WEAPON
  MELEE_WEAPON
  AMMO
  CLOTHING
  CONSUMABLE
  MATERIAL
}

type ItemData {
  key              String
  type             ItemType
  FIREARM_WEAPON   FirearmWeaponItem?
  THROWABLE_WEAPON ThrowableWeaponItem?
  MELEE_WEAPON     MeleeWeaponItem?
  AMMO             AmmoItem?
  CLOTHING         ClothingItem?
  CONSUMABLE       ConsumableItem?
  MATERIAL         MaterialItem?
}

type FirearmWeaponItem {
  customName String?
  durability Float

  ammo       EquipedAmmo?
  tint       Int          @default(0)
  components Int[]        @default([])
}

type ThrowableWeaponItem {
  amount Int
}

type MeleeWeaponItem {
  customName String?
  durability Float

  tint       Int   @default(0)
  components Int[] @default([])
}

type EquipedAmmo {
  key  String
  data AmmoItem
}

type AmmoItem {
  amount Int
}

type ClothingItem {
  customName String?
  durability Float

  // Color
  texture Int
}

type ConsumableItem {
  amount Int
}

type MaterialItem {
  amount Int
}

type Position {
  x Float
  y Float
  z Float
}

type Appearance {
  // 0 - Female, 1 - Male
  sex Int

  // Values range from 0 to 45
  faceFather Int

  // Values range from 0 to 45
  faceMother Int

  // Values range from 0 to 45
  skinFather Int

  // Values range from 0 to 45
  skinMother Int

  // The mix of the mother and father faces.
  // Values range from 0.0 to 1.0
  faceMix Float

  // The mix of the mother and father faces.
  // Values range from 0.0 to 1.0
  skinMix Float

  // An array of valid face features changes.
  // Each position in the array represents a feature change.
  // Values range from -1.0 to 1.0
  features Float[]

  // These have to do with blemishes, makeup, lipstick, etc.
  headOverlays HeadOverlay[]

  // The hair identifier that this character will be using.
  // Should be a relative id to the dlc hash.
  hair           Int
  hairCollection String
  hairOverlay    String

  // The dlc hash of the hair to use.
  hairDlc Int

  // The color of the hair.
  hairColor1 Int

  // The highlight color of the hair.
  hairColor2 Int

  // Eye Color
  eyes Int
}

type HeadOverlay {
  id      Int
  value   Int
  opacity Float?
  color1  Int?
  color2  Int?
}
