// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  username   String      @unique
  discordId  String      @unique
  fresh      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  characters Character[]
  interface  Interface?
}

type Interface {
  inventory  InventoryInterface?
  questMenu  QuestMenuInterface?
  skillsMenu SkillsMenuInterface?
}

type InventoryInterface {
  screen ScreenPosition
}

type QuestMenuInterface {
  screen ScreenPosition
}

type SkillsMenuInterface {
  screen ScreenPosition
}

type ScreenPosition {
  x Int
  y Int
  w Int
  h Int
}

model Character {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  name         String     @unique
  lastPosition Position
  rot          Float
  appearance   Appearance
  health       Float      @default(100)
  maxHealth    Float      @default(100)
  money        Int        @default(0)
  createdAt    DateTime   @default(now())
  questFacts   String[]   @default([])
  blueprints   String[]   @default([])
  inventory    Inventory
  equipment    Json // typed in TS as Equipment
  skills       Skills
}

model Shop {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  inventory Inventory
  ped       Ped
}

model DroppedItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  item      Json // typed in TS as Item
  pos       Position
  createdAt DateTime @default(now())
}

type Ped {
  model   String
  pos     Position
  heading Float
}

type Skills {
  woodcutting Int @default(0)
  fishing     Int @default(0)
  mining      Int @default(0)
}

type Inventory {
  items InventoryItem[]
  size  Int
}

type InventoryItem {
  slot  Int
  item  Json // typed in TS as Item
  price Int?
}

type Position {
  x Float
  y Float
  z Float
}

type Appearance {
  // 0 - Female, 1 - Male
  sex Int

  // Values range from 0 to 45
  faceFather Int

  // Values range from 0 to 45
  faceMother Int

  // Values range from 0 to 45
  skinFather Int

  // Values range from 0 to 45
  skinMother Int

  // The mix of the mother and father faces.
  // Values range from 0.0 to 1.0
  faceMix Float

  // The mix of the mother and father faces.
  // Values range from 0.0 to 1.0
  skinMix Float

  // An array of valid face features changes.
  // Each position in the array represents a feature change.
  // Values range from -1.0 to 1.0
  features Float[]

  // These have to do with blemishes, makeup, lipstick, etc.
  headOverlays HeadOverlay[]

  // The hair identifier that this character will be using.
  // Should be a relative id to the dlc hash.
  hair           Int
  hairCollection String
  hairOverlay    String

  // The dlc hash of the hair to use.
  hairDlc Int

  // The color of the hair.
  hairColor1 Int

  // The highlight color of the hair.
  hairColor2 Int

  // Eye Color
  eyes Int
}

type HeadOverlay {
  id      Int
  value   Int
  opacity Float?
  color1  Int?
  color2  Int?
}
