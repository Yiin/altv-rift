{
  "scripts": {
    "setup-project": "npm i && altv-pkg rc",
    "build:server": "node --es-module-specifier-resolution=node build/server",
    "build:client": "node --es-module-specifier-resolution=node build/client",
    "dev:server": "node --es-module-specifier-resolution=node build/server -dev",
    "dev:client": "node --es-module-specifier-resolution=node build/client -dev",
    "before-any": "npm i && node --es-module-specifier-resolution=node build/copy",
    "dev": "npm run before-any && concurrently \"npm:dev:*\" \"npm:tsc\" -c \"magenta.bold,cyan.bold\"",
    "build": "npm run before-any && concurrently \"npm:build:*\"",
    "upd-altv-types": "npm i @altv/types-shared@latest @altv/types-client@latest @altv/types-server@latest @altv/types-natives@latest",
    "tsc:server": "cd src/server && npx tsc -w",
    "tsc:client": "cd src/client && npx tsc -w",
    "tsc": "concurrently \"npm:tsc:*\" -c \"magenta.bold,cyan.bold\"",
    "devall": "npm run before-any && concurrently \"npm:dev\" \"./server-dev.bat\" -c \"magenta.bold,cyan.bold\"",
    "mongo": "docker-compose up -d",
    "prisma:generate": "prisma generate",
    "server": "npm run setup-project && npm run mongo && server-dev.bat"
  },
  "type": "module",
  "dependencies": {
    "@altv/types-client": "^2.8.7",
    "@altv/types-natives": "^1.5.4",
    "@altv/types-server": "^2.9.0",
    "@altv/types-shared": "^1.5.8",
    "@prisma/client": "^5.1.1",
    "@sentry/node": "^7.30.0",
    "@sentry/tracing": "^7.30.0",
    "@vue/reactivity": "^3.2.47",
    "@vue/runtime-core": "^3.2.47",
    "alpha-serializer": "^0.5.6",
    "altv-esbuild": "^0.4.11",
    "altv-pkg": "^2.2.3",
    "axios": "^1.3.2",
    "btreemap": "^0.1.14",
    "chalk": "^5.2.0",
    "chokidar": "^3.5.3",
    "concurrently": "^7.3.0",
    "core-js": "^3.29.0",
    "core-js-pure": "^3.29.0",
    "cors": "^2.8.5",
    "disconnected": "^0.2.1",
    "discord.js": "^14.8.0",
    "domdiff": "^2.2.2",
    "domsanitizer": "^0.2.3",
    "domtagger": "^0.7.2",
    "dotenv": "^16.0.3",
    "elliptic": "^6.5.4",
    "esbuild": "^0.16.16",
    "express": "^4.18.2",
    "glob": "^9.3.2",
    "inversify": "^6.0.1",
    "js-quadtree": "^3.3.6",
    "js-yaml": "^4.1.0",
    "jsdom": "^22.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "mnemonist": "^0.39.5",
    "pinia": "^2.1.4",
    "proxy-deep": "^3.1.1",
    "reflect-metadata": "^0.1.13",
    "sjcl": "^1.0.8",
    "typescript": "^4.9.4",
    "umap": "^1.0.2",
    "validator": "^13.7.0",
    "vue": "^3.3.4",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@babel/types": "^7.20.7",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.191",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^18.11.18",
    "@types/sjcl": "^1.0.30",
    "@types/validator": "^13.7.10",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-xo": "^0.43.1",
    "eslint-config-xo-typescript": "^0.55.1",
    "eslint-plugin-import": "^2.27.4",
    "fs-extra": "^11.1.1",
    "node-ipc": "^11.1.0",
    "prettier": "2.8.3",
    "prisma": "^5.1.1",
    "prisma-import": "^1.0.4",
    "ts-node": "^10.9.1",
    "xml-js": "^1.6.11"
  }
