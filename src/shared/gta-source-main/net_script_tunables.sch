// -----------------------------------------------------------------------------------------------------------

FUNC BOOL ERROR_CHECK_TUNABLES( ) 

	INT I
	FOR I = 0 TO MAX_NUM_RANKS-1
		IF MPGlobalsHud.TunableCheck_PreviousXP > g_sMPTunableArrays.iTopRankValues[I] 
			SCRIPT_ASSERT("ERROR_CHECK_TUNABLES: XP Value in the Rank Table is greater than previous ")
			PRINTLN("ERROR_CHECK_TUNABLES: XP for g_sMPTunableArrays.iTopRankValues[",i,"] = ",g_sMPTunableArrays.iTopRankValues[I]," is less than the XP level for the rank before: ",MPGlobalsHud.TunableCheck_PreviousXP)
		ENDIF
		MPGlobalsHud.TunableCheck_PreviousXP = g_sMPTunableArrays.iTopRankValues[I] 
		#IF IS_DEBUG_BUILD
		IF GET_COMMANDLINE_PARAM_EXISTS("sc_tuneableDebugPrints") 
			PRINTLN("ERROR_CHECK_TUNABLES: XP for g_sMPTunableArrays.iTopRankValues[",i,"] = ",g_sMPTunableArrays.iTopRankValues[I])
		ENDIF
		#ENDIF
	ENDFOR
	
	MPGlobalsHud.TunableCheck_PreviousXP = 0
	
	RETURN FALSE
	
ENDFUNC



// -----------------------------------------------------------------------------------------------------------
//     The Main Setup Function
// -----------------------------------------------------------------------------------------------------------

PROC REFRESH_MP_SCRIPT_TUNEABLES_CASE_0(g_eTunablesContexts paramContext, g_eTunablesContexts paramContextSubType, BOOL bFillRankTuneables)
	NET_PRINT("\n REFRESHING TUNABLES REFRESH_MP_SCRIPT_TUNEABLES_CASE_0")
	// For safety, return all tunables to their default values before layerin gon any changes
