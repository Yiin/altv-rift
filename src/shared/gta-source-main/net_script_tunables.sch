// PURPOSE:	Reload the Tunable Global Variables
//
// INPUT PARAMS:			paramContext			The context used to fill the variables
//
// NOTES:	THIS IS THE MAIN FUNCTION THE GAME SHOULD BE CALLING - THE REST ARE HELPER FUNCTIONS FOR THIS ONE
FUNC BOOL Refresh_MP_Script_Tunables(g_eTunablesContexts paramContext, g_eTunablesContexts paramContextSubType, BOOL bFillRankTuneables)
	
	IF (paramContext = TUNE_CONTEXT_FM)
		IF IS_TRANSITION_SESSION_LAUNCHING()
			IF (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_BASE_JUMP)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_RACE)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_RACE_TO_POINT)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_DEATHMATCH)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_SURVIVAL)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_MISSION_LTS)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_MISSION)
			OR (g_FMMC_STRUCT.iMissionType = FMMC_TYPE_MISSION_COOP)
				NET_PRINT("Refresh_MP_Script_Tunables IS_TRANSITION_SESSION_LAUNCHING TRUE. NOT FILLING TUNABLES")
				RETURN TRUE
			ENDIf
		ENDIF
	ENDIF
	//PRINTLN("Refresh_MP_Script_Tunables paramContext = ", ENUM_TO_INT(paramContext), " paramContextSubType = ", ENUM_TO_INT(paramContextSubType))
	
	NET_PRINT("Refresh_MP_Script_Tunables IS_TRANSITION_SESSION_LAUNCHING FALSE. FILLING TUNABLES")
	
	// A safety check
	IF (paramContext = MAX_TUNABLES_CONTEXTS)
		CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: Refresh_MP_Script_Tunables() called on MAX_TUNABLES_CONTEXTS from: ", GET_THIS_SCRIPT_NAME())
		SCRIPT_ASSERT("Refresh_MP_Script_Tunables() - ERROR, called with MAX_TUNABLES_CONTEXTS. Look at Console Log. Tell Kevin.")
		RETURN TRUE
	ENDIF
	
	#IF IS_DEBUG_BUILD
		PRINTNL()
		TEXT_LABEL_63 tl63dbg1 = Get_Tunable_Context_As_String(paramContext)
		TEXT_LABEL_63 tl63dbg2 = Get_Tunable_Context_As_String(paramContextSubType)
		CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: Retrieving Tunable Variable Data for this context: ", tl63dbg1, " = MODIFIER", tl63dbg2)
		CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: bFillRankTuneables = ", bFillRankTuneables)
		CDEBUG1LN(DEBUG_TUNEABLES, "...KGM MP [Tunables]: g_sMPTunables.iFillStage = ", g_sMPTunables.iFillStage)
		DEBUG_PRINTCALLSTACK()
	#ENDIF
	
	SWITCH g_sMPTunables.iFillStage
		
		CASE 0
			REFRESH_MP_SCRIPT_TUNEABLES_CASE_0(paramContext, paramContextSubType, bFillRankTuneables)
			g_sMPTunables.iFillStage++
		BREAK
		
		CASE 1
			REFRESH_MP_SCRIPT_TUNEABLES_CASE_1(paramContext, paramContextSubType)
			g_sMPTunables.iFillStage++
