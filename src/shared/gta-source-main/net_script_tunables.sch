USING "rage_builtins.sch"
USING "globals.sch"

USING "net_script_tunables_game_defaults.sch"
USING "net_transition_sessions.sch"
USING "net_script_tunables_new.sch"
USING "net_script_tunables_new_2.sch"
// *************************************************************************************************************************************
// *************************************************************************************************************************************
// *************************************************************************************************************************************
//
//      MISSION NAME    :   net_script_tunables.sch
//      CREATED         :   Kevin
//      DESCRIPTION     :   A public interface for all script tunables functionality.
//		NOTES			:	Script Tunables are script globals that can have their values overwritten from the cloud.
//							This allows post-release modifications and tweaking.
//							Only the values that have been modified will be stored in the cloud.
//							I've set these up as contexts with different scopes which means a value can be modified at, for example,
//								the MP level, or the CnC level, or at the Vagos level.
//							When setting the values of these variables it'll first set them with any changes at the lowest scope
//								(ie: MP-specific changes) then at each higher scope (CnC-specific changes, then Vagos-Specific changes)
//								allowing a value to be generally changed for the whole MP game, but then specifically different for the
//								Vagos.
//
//							Currently using these Contexts (indented to show scope and associated nested scope levels):
//								MP_GLOBALS
//									CNC
//										CNC_TEAM_0
//										CNC_TEAM_1
//										CNC_TEAM_2
//									FM
//										FM_DM
//										FM_RACES
//
//							JSON File Here: //depot/gta5/build/dev/common/data/tune/tunables.json
//
//							TO ADD A NEW TUNABLE, DO THH FOLLOWING:
//								- Add a variable to g_structMPScriptTunables in x:\gta5\script\dev\multiplayer\globals\mp_globals_tunables.sch
//								- Add an entry to Debug_Output_Tunable_Variable_Values() below
//
// *************************************************************************************************************************************
// *************************************************************************************************************************************
// *************************************************************************************************************************************

STRUCT TUNEABLES_LANCHER_STRUCT
	g_eTunablesContexts eContext
	g_eTunablesContexts eContextSubType
	BOOL bFillRankTuneables
ENDSTRUCT


// ===========================================================================================================
//      Debug Functions
// ===========================================================================================================

#IF IS_DEBUG_BUILD
PROC Debug_Output_Tunable_Variable_Values(BOOL paramJustReset = FALSE)

//	IF GET_COMMANDLINE_PARAM_EXISTS("sc_tuneableDebugPrints") 
		
		PRINTNL()
		IF (paramJustReset)
			CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: Tunable Variable Cleared To Script Defaults:")
		ELSE
			CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: Tunable Variable Values In Use:")
		ENDIF
		PRINTNL()
			

		// All the General Tunable Globals
		CDEBUG1LN(DEBUG_TUNEABLES, "      XP Multiplier                   : ", g_sMPTunables.xpMultiplier)
		CDEBUG1LN(DEBUG_TUNEABLES, "      Cash Multiplier                 : ", g_sMPTunables.cashMultiplier)
		CDEBUG1LN(DEBUG_TUNEABLES, "      iTunePosixTime                  : ", g_sMPTunables.iTunePosixTime)
		
		
