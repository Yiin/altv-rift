		CASE 74
			END_REFRESH_MP_SCRIPT_TUNEABLES()
			ERROR_CHECK_TUNABLES()
			GET_POSIX_TIME(aTimeforrefreshingtunables.Year, aTimeforrefreshingtunables.Month, aTimeforrefreshingtunables.Day, aTimeforrefreshingtunables.Hour, aTimeforrefreshingtunables.Minute, aTimeforrefreshingtunables.Seconds)
