		CDEBUG1LN(DEBUG_TUNEABLES, "      Amount To Forgive Cheat By      : ", g_sMPTunables.cheatAmountToForgiveBy)
		CDEBUG1LN(DEBUG_TUNEABLES, "      Cheat Reset Mins                : ", g_sMPTunables.cheatResetMinutes)
		CDEBUG1LN(DEBUG_TUNEABLES, "      Kick Votes Needed Ratio         : ", g_sMPTunables.kickVotesNeededRatio)
		
		CDEBUG1LN(DEBUG_TUNEABLES,  "DISABLE_QUICK_JOB_WITH_FRIENDS"		,g_sMPTunables.bDisableQuickJobWithFriends)
		CDEBUG1LN(DEBUG_TUNEABLES,  "DISABLE_NJVS_QM"		,g_sMPTunables.bDisableNjvsQuickMatch)
		CDEBUG1LN(DEBUG_TUNEABLES,  "DISABLE_QJ_CONTENT_FILTER"		,g_sMPTunables.bDisableQuickJobContentFilter)
		
		CDEBUG1LN(DEBUG_TUNEABLES,  "NUM_NJVS_PAGES"		,g_sMPTunables.iNumPagesOnNJVS)
		CDEBUG1LN(DEBUG_TUNEABLES,  "DISABLE_NJVS_PLAYSTYLE"		,g_sMPTunables.bDisablePlayStyle)
		CDEBUG1LN(DEBUG_TUNEABLES,  "DISABLE_NJVS_RANDOM"		,g_sMPTunables.bDisableNjvsRandom)
		
		CDEBUG1LN(DEBUG_TUNEABLES,  "NJVS_TIMOUT"		,g_sMPTunables.iNjvsTimeOut)
		CDEBUG1LN(DEBUG_TUNEABLES,  "CORONA_TRIGGER_TIMER"		,g_sMPTunables.iCornaTimeOut)
