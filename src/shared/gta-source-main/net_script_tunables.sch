// -----------------------------------------------------------------------------------------------------------

#IF IS_DEBUG_BUILD
// PURPOSE:	If required, check for a game breaking value coming in as a tunable and highlight it as an assert.
// NOTES:	Not all tunables will need this.
//			Example of Game Breaking Bad Values: Modifiers that act as multiplers to a value being loaded as 0.000
PROC Debug_Perform_Bad_Tunable_Value_Checks()
	
	IF GET_COMMANDLINE_PARAM_EXISTS("sc_tuneableDebugPrints") 
		
		// XP Multiplier shouldn't be 0
		IF (g_sMPTunables.xpMultiplier = 0.0)
			CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: ERROR - g_sMPTunables.xpMultiplier = 0.0. Setting to 1.0.")
			SCRIPT_ASSERT("Debug_Perform_Bad_Tunable_Value_Checks: ERROR - g_sMPTunables.xpMultiplier = 0.0")
			g_sMPTunables.xpMultiplier = 1.0
		ENDIF

		// Cash Multiplier shouldn't be 0
		IF (g_sMPTunables.cashMultiplier = 0.0)
			CDEBUG1LN(DEBUG_TUNEABLES, "[Tunables]: ERROR - g_sMPTunables.cashMultiplier = 0.0. Setting to 1.0.")
			SCRIPT_ASSERT("Debug_Perform_Bad_Tunable_Value_Checks: ERROR - g_sMPTunables.cashMultiplier = 0.0")
			g_sMPTunables.cashMultiplier = 1.0
		ENDIF
	
	ENDIF
	
ENDPROC
#ENDIF




// ===========================================================================================================
//      General Functions
// ===========================================================================================================

// PURPOSE:	Clear the struct, which will also set all values back to their defaults
//
// INPUT PARAMS:			paramContext			The context used to fill the variables
PROC Reset_All_Tunables_To_Script_Defaults(g_eTunablesContexts paramContext, BOOL bFillRankTuneables)
	
	IF bFillRankTuneables
		g_TransitionSessionNonResetVars.bFilledRankTuneables = FALSE
	ENDIF
	
	
	IF paramContext = TUNE_CONTEXT_FM
	
	ENDIF
	
	INT i
	g_sMPTunables.bTogglexmascontent = FALSE
	g_sMPTunables.iCrateDropWeapons[0]		=	HASH("WEAPON_RPG")
