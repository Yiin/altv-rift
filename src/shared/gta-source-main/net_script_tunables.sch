			#ENDIF
			
			g_sMPTunables.iFillStage++
		
		BREAK
			
		CASE 75
			g_sMPTunables.iFillStage = 0
			//Set flag to run tunable check
			g_bRunTunableValidationChecks = TRUE
			g_bHasCopiedAllTunableValuesToScriptGlobals = TRUE
			g_bHas_Tunables_Been_set_at_least_once = TRUE
			RETURN TRUE
		BREAK
		
		
	
	ENDSWITCH
		
	//PRINTLN("[BWTUN] - g_sMPTunables.iFillStage = "), g_sMPTunables.iFillStage)	
	RETURN FALSE
	
ENDFUNC

// Added by KW. Seems like tunables are not being filled quick enough for betting screen. 
// 2/9/2014
PROC REFRESH_BETTING_TUNABLES_EARLY(g_eTunablesContexts	paramContext, g_eTunablesContexts paramContextSubType)
	
	g_sMPTunables.btoggle_on_bet_stake_gift_LTS		= FALSE
	g_sMPTunables.icash_reward_bet_stake_gift	= 100
	g_sMPTunables.iarmour_reward_gift= 100
	
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_DM				= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_RACES_CAR		= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_RACES_CYCLE		= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_RACES_AIR		= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_RACES_SEA		= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_MISSIONS			= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_SURVIAL			= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_BASEJUMP			= FALSE
	g_sMPTunables.bTOGGLE_ON_BET_STAKE_GIFT_CAPTURE		= FALSE

	Fill_MP_Int_Tunable(paramContext, paramContextSubType, HASH("CASH_REWARD_BET_STAKE_GIFT"), g_sMPTunables.icash_reward_bet_stake_gift)
	Fill_MP_Int_Tunable(paramContext, paramContextSubType, HASH("ARMOUR_REWARD_GIFT"), g_sMPTunables.iarmour_reward_gift	)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_DM"), g_sMPTunables.btoggle_on_bet_stake_gift_DM					)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_RACES_CAR"), g_sMPTunables.btoggle_on_bet_stake_gift_RACES_CAR				)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_RACES_CYCLE"), g_sMPTunables.btoggle_on_bet_stake_gift_RACES_CYCLE			)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_RACES_AIR"), g_sMPTunables.btoggle_on_bet_stake_gift_RACES_AIR				)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_RACES_SEA"), g_sMPTunables.btoggle_on_bet_stake_gift_RACES_SEA				)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_MISSIONS"), g_sMPTunables.btoggle_on_bet_stake_gift_MISSIONS				)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_SURVIAL"), g_sMPTunables.btoggle_on_bet_stake_gift_SURVIAL				)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_BASEJUMP"), g_sMPTunables.btoggle_on_bet_stake_gift_BASEJUMP				)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_CAPTURE"), g_sMPTunables.btoggle_on_bet_stake_gift_CAPTURE				)	
	Fill_MP_BOOL_Tunable(paramContext, paramContextSubType, HASH("DISABLE_MODIFIER_BADGES"), g_sMPTunables.bdisable_modifier_badges					)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("toggle_on_bet_stake_gift_LTS"), g_sMPTunables.btoggle_on_bet_stake_gift_LTS					)
	Fill_MP_Bool_Tunable(paramContext, paramContextSubType, HASH("PLAYLIST_EVENT_GIFT_ACTIVE"), g_sMPTunables.bEventPlayListGiftActive)
	
	CDEBUG1LN(DEBUG_TUNEABLES, "PLAYLIST_EVENT_GIFT_ACTIVE", g_sMPTunables.bEventPlayListGiftActive)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_LTS EARLY", g_sMPTunables.btoggle_on_bet_stake_gift_LTS			)
	CDEBUG1LN(DEBUG_TUNEABLES,"CASH_REWARD_BET_STAKE_GIFT EARLY", g_sMPTunables.icash_reward_bet_stake_gift)
	CDEBUG1LN(DEBUG_TUNEABLES,"ARMOUR_REWARD_GIFT EARLY", g_sMPTunables.iarmour_reward_gift	)
	CDEBUG1LN(DEBUG_TUNEABLES,"CASH_REWARD_BET_STAKE_GIFT EARLY ", g_sMPTunables.icash_reward_bet_stake_gift)
	CDEBUG1LN(DEBUG_TUNEABLES,"ARMOUR_REWARD_GIFT EARLY ", g_sMPTunables.iarmour_reward_gift	)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_DM EARLY ", g_sMPTunables.btoggle_on_bet_stake_gift_DM					)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_RACES_CAR EARLY ", g_sMPTunables.btoggle_on_bet_stake_gift_RACES_CAR				)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_RACES_CYCLEEARLY ", g_sMPTunables.btoggle_on_bet_stake_gift_RACES_CYCLE			)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_RACES_AIR EARLY ", g_sMPTunables.btoggle_on_bet_stake_gift_RACES_AIR				)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_RACES_SEA EARLY", g_sMPTunables.btoggle_on_bet_stake_gift_RACES_SEA				)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_MISSIONS EARLY ", g_sMPTunables.btoggle_on_bet_stake_gift_MISSIONS				)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_SURVIAL EARLY", g_sMPTunables.btoggle_on_bet_stake_gift_SURVIAL				)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_BASEJUMP EARLY ", g_sMPTunables.btoggle_on_bet_stake_gift_BASEJUMP				)
	CDEBUG1LN(DEBUG_TUNEABLES,"toggle_on_bet_stake_gift_CAPTURE EARLY", g_sMPTunables.btoggle_on_bet_stake_gift_CAPTURE				)


ENDPROC


// Added by KW. Seems like tunables are not being filled quick enough for DAILY OBJECTIVE. 
// 2/9/2014
PROC REFRESH_DAILY_OBJECTIVE_TUNABLES_EARLY(g_eTunablesContexts	paramContext, g_eTunablesContexts paramContextSubType)
	PRINTLN("REFRESH_DAILY_OBJECTIVE_TUNABLES_EARLY")
	
	// g_smptunables.bDisableDailyObjectiveServerAuthoritative
	// g_sMPTunables.idaily_obj_time_refresh
	// g_sMPTunables.iNUM_OBJECTIVES_IN_HISTORY_LIST
	// g_smptunables.bUseDailyObjectiveLimitedPool
	// g_smptunables.iNumJobObjectivesInPool
	// g_sMPTunables.iMP_DAILY_OBJECTIVE_POOL (0 to 99)
	// g_sMPTunables.iOBJECTIVE_POOL_SIZE
	
	INT i
	
	REPEAT 100 i
		g_sMPTunables.iMP_DAILY_OBJECTIVE_POOL[i] 	= 0 //- an INT array with a size of 100, default values not determined yet.
	ENDREPEAT
	g_sMPTunables.iOBJECTIVE_POOL_SIZE 							= 30		//-				 INT, should default to 30, max 100
	g_sMPTunables.bdisabledailyobjectiveserverauthoritative = FALSE
	g_sMPTunables.idaily_obj_time_refresh							= 6
	g_sMPTunables.iNUM_OBJECTIVES_IN_HISTORY_LIST					=6		//- INT,should default to 6, max 21
	g_sMPTunables.bUseDailyObjectiveLimitedPool = FALSE
	g_sMPTunables.iNumJobObjectivesInPool	= 30
