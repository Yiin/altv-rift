.compass {
  display: block;
  position: absolute;
  top: 0;
  width: 25.375rem;
  height: 4.25rem;
  font-family: akrobat-bold;
}

.compass__container {
  display: block;
  position: relative;
  width: 25.375rem;
  height: 6.25rem;
}

.compass__center {
  display: block;
  width: 0.1875rem;
  height: 1.0625rem;
  background-color: #D9D9D9;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, 0);
}

.compass__ticks {
  display: block;
  position: relative;
  width: 25.375rem;
  height: 6.25rem;
  transform: translate(-50%, 0);
}

.compass__tick {
  position: absolute;
  top: 0;
  left: 1.8125rem;
  width: 3.625rem;
  opacity: 0.6;
}

.compass__tick--side {
  opacity: 1;
  font-effect: outline(1px #555555);
}

.compass__tick-container {
  display: block;
  position: relative;
  width: 3.625rem;
  text-align: center;
}

.compass__tick-label {
  display: block;
  margin-top: 1.5625rem;

  color: #FFF;

  font-size: 0.875rem;
}

.compass__tick--side .compass__tick-label {
  margin-top: 1.5625rem;
  font-size: 1.25rem;
}

.compass__tick-indicator {
  display: block;
  position: absolute;
  top: 0;
  left: 50%;
  transform-origin: center;
  width: 0.0625rem;
  height: 1.0625rem;
  background-color: #D9D9D9;
}

.compass__tick--side .compass__tick-indicator {
  background-color: #D9D9D9;
}

.compass__icons {
  display: block;
  position: relative;
  width: 25.375rem;
  height: 6.25rem;
  margin-top: -3.5rem;
  transform: translate(-50%, 0);
}

.compass__icon {
  position: absolute;
  top: 0;
  left: 1.8125rem;
  width: 3.625rem;
  opacity: 0.6;
  transform: translate(-50%, 0);
}

.compass__icon-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  width: 3.625rem;
  height: 4rem;
}

.compass__icon-caret {
  display: block;
  width: 0.5rem;
  height: 0.3125rem;
}

.compass__icon-uhh-actual-icon-i-guess {
  display: block;
  width: 1rem;
  height: 1rem;
  margin-top: 0.375rem;
}

.compass__icon-distance {
  display: block;
  font-size: 1rem;
  text-align: center;
  margin-top: 0.25rem;
}
