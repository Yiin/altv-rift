@keyframes pulse-animation {
  0%, 100% {
    transform: scale(0.37);
    opacity: 0.06;
  }
  50% {
    transform: scale(1);
    opacity: 0.2;
  }
}

.indicator {
  display: block;
  position: relative;
  width: 50px;
  height: 50px;
}

.indicator__glow-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 43px;
  height: 43px;
  transform: translate(-50%, -50%);
  transform-origin: center;
}

.indicator__glow {
  width: 43px;
  height: 43px;
  animation: 3s ease-in-out infinite pulse-animation;
  transform-origin: center;
}

.indicator__dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24px;
  height: 24px;
  transform-origin: center;
}
