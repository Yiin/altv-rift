<rml>
  <head>
      <title>NPC</title>
      <style>
          body {
              font-family: josefinsans;

              width: 100%;
              height: 100%;
          }

          .hide {
              display: none;
          }

          /**
           * Nametags
           */
          .nametag-wrapper {
              position: absolute;
              text-align: center;
          }

          .nametag {
              font-effect: outline(2px black);
              font-style: normal;
              font-size: 30pt;
              color: #FFFFFFFF;
              transform-origin: center center;
          }

          /**
           * Interactions
           */
          .interaction-wrapper {
              position: absolute;
              text-align: center;
          }

          .interaction-content {
              font-size: 25pt;
              color: #FFFFFFFF;
              transform-origin: center center;
          }

          /**
           * Icons
           */
          .icon {
              width: 50px;
              height: 50px;
              font-effect: outline(1px black);
          }
      </style>
  </head>
  <body id="container"></body>
</rml>
