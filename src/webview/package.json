    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "rollup-plugin-external-globals": "^0.9.2",
    "sass": "^1.72.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.4.0",
    "vite": "^5.1.5",
    "vite-plugin-vuetify": "^2.0.3",
    "vue-tsc": "^2.0.6"
