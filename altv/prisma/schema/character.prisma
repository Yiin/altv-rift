model Character {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  name         String     @unique
  lastPosition Position
  rot          Float
  appearance   Appearance
  health       Float      @default(100)
  maxHealth    Float      @default(100)
  money        Int        @default(0)
  createdAt    DateTime   @default(now())
  questFacts   String[]   @default([])
  blueprints   String[]   @default([])
  inventory    Inventory
  equipment    Json // typed in TS as Equipment
  skills       Skills
}

type Skills {
  woodcutting  ProfessionSkill
  fishing      ProfessionSkill
  mining       ProfessionSkill
  crafting     ProfessionSkill
  medic        ProfessionSkill
  engineer     ProfessionSkill
  farmer       ProfessionSkill
  foodDelivery ProfessionSkill
  cargoCarrier ProfessionSkill
  firefighter  ProfessionSkill
  builder      ProfessionSkill
  electrician  ProfessionSkill
  plumber      ProfessionSkill
  mechanic     ProfessionSkill
  gardener     ProfessionSkill
  mortician    ProfessionSkill
}

type ProfessionSkill {
  exp           Int      @default(0)
  learnedSkills String[]
  stats         Json? // For tracking profession-specific statistics
}

model Migration {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  executedAt DateTime @default(now())
}

type Appearance {
  // 0 - Female, 1 - Male
  sex Int

  // Values range from 0 to 45
  faceFather Int
  faceMother Int
  skinFather Int
  skinMother Int

  // The mix of the mother and father faces.
  // Values range from 0.0 to 1.0
  faceMix Float
  skinMix Float

  // An array of valid face features changes.
  // Each position in the array represents a feature change.
  // Values range from -1.0 to 1.0
  features Float[]

  // These have to do with blemishes, makeup, lipstick, etc.
  headOverlays HeadOverlay[]

  // The hair identifier that this character will be using.
  // Should be a relative id to the dlc hash.
  hair           Int
  hairCollection String
  hairOverlay    String

  // The dlc hash of the hair to use.
  hairDlc Int

  // The color of the hair.
  hairColor1 Int

  // The highlight color of the hair.
  hairColor2 Int

  // Eye Color
  eyes Int
}

type HeadOverlay {
  id      Int
  value   Int
  opacity Float?
  color1  Int?
  color2  Int?
}
