@keyframes damage-fade-1 {
  from {
    transform: translateY(0) scale(0.2);
  }
  to {
    transform: translateY(-100px) scale(1);
  }
}

@keyframes damage-fade-2 {
  from {
    transform: translate(0, 0) scale(0.2);
  }
  to {
    transform: translate(50px, -86.60px) scale(1);
  }
}

@keyframes damage-fade-3 {
  from {
    transform: translate(0, 0) scale(0.2);
  }
  to {
    transform: translate(86.60px, -50px) scale(1);
  }
}

@keyframes damage-fade-4 {
  from {
    transform: translate(0, 0) scale(0.2);
  }
  to {
    transform: translate(100px, 0) scale(1);
  }
}

@keyframes damage-fade-5 {
  from {
    transform: translate(0, 0) scale(0.2);
  }
  to {
    transform: translate(-100px, 0) scale(1);
  }
}

@keyframes damage-fade-6 {
  from {
    transform: translate(0, 0) scale(0.2);
  }
  to {
    transform: translate(-86.60px, -50px) scale(1);
  }
}

@keyframes damage-fade-7 {
  from {
    transform: translate(0, 0) scale(0.2);
  }
  to {
    transform: translate(-50px, -86.60px) scale(1);
  }
}
