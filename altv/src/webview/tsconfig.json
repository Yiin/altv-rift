{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "../shared/**/*",
    "../../node_modules/@prisma/client/**/*"
  ],
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@altv",
      "./node_modules/@types",
      "./src/typings"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@prisma/client": ["../../node_modules/@prisma/client/*"]
    }
  },
  "references": [{ "path": "./tsconfig.node.json" }]
}
