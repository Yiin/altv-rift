.pedNameTagContainer {
	position: absolute;
}

.pedNameTag {
	text-align: center;
	transform-origin: center bottom 0px;
	width: 12.5rem; /* 200px */
	height: 18.75rem; /* 300px */
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	align-items: center;
}

.pedNameTagContent {
	transform-origin: center bottom;
}
