{
  "scripts": {
    "update": "bun i && altv-pkg",
    "build:server": "bun run build/server.ts",
    "build:client": "bun run build/client.ts",
    "dev": "bun run scripts/dev.ts --server --client --tsc",
    "dev:server": "bun run scripts/dev.ts --server",
    "dev:client": "bun run scripts/dev.ts --client",
    "tsc:server": "bun run scripts/dev.ts --tsc:server",
    "tsc:client": "bun run scripts/dev.ts --tsc:client",
    "tsc:all": "bun run scripts/dev.ts --tsc",
    "format": "eslint --fix src/client/**/*.ts src/server/**/*.ts src/shared/**/*.ts",
    "build": "bun run build:server && bun run build:client",
    "upd-altv-types": "bun i @altv/shared@latest @altv/client@latest @altv/server@latest @altv/natives@latest",
    "prisma:generate": "bunx prisma generate",
    "watcher": "bun run build/watcher.ts",
    "server": "bun run watcher"
  },
  "type": "module",
  "dependencies": {
