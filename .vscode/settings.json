{
  "typescript.tsdk": "node_modules\\typescript\\lib",
  "evenBetterToml.schema.associations": {
    "server-(.*).toml": "https://raw.githubusercontent.com/xxshady/altv-config-schemas/main/server-config.schema.json?v=awdassdw"
  },
  "editor.tabSize": 2,
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "eslint.validate": ["javascript", "typescript"],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "altv/src/webview": true
  }
}
