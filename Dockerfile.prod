FROM node:20.11.0-bookworm-slim as deps
USER root

RUN apt-get update -y && \
  apt-get install -y \
  # for altv server
  curl \
  lsof \
  libatomic1 \
  libc-bin \
  wget \
  apt-transport-https \
  ca-certificates \
  gnupg \
  unzip \
  # utils
  procps \
  stow \
  # cdn sync
  s3cmd && \
  # cleanup
  apt autoremove -y && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

# Install global packages
RUN curl -fsSL https://bun.sh/install | bash && \
    ln -s ~/.bun/bin/bun /usr/local/bin/bun && \
    ln -s ~/.bun/bin/bunx /usr/local/bin/bunx && \
    bun --version

# Set common environment variables for all stages
ARG BRANCH=release
ARG DATABASE_URL
ARG DISCORD_CLIENT_ID
ARG DISCORD_CLIENT_SECRET
ARG REDIRECT_IP
ARG SERVER_ENV
ARG ALTV_HOST
ARG ALTV_USE_ENV_CONFIG
ARG ALTV_NAME
ARG ALTV_PORT
ARG ALTV_PASSWORD
ARG ALTV_ANNOUNCE
ARG ALTV_DEBUG
ARG ALTV_MODULES
ARG ALTV_RESOURCES
ARG ALTV_TOKEN
ARG VITE_CDN_URL

ENV ALTV_BRANCH=$BRANCH
ENV DATABASE_URL=$DATABASE_URL
ENV DISCORD_CLIENT_ID=$DISCORD_CLIENT_ID
ENV DISCORD_CLIENT_SECRET=$DISCORD_CLIENT_SECRET
ENV REDIRECT_IP=$REDIRECT_IP
ENV SERVER_ENV=$SERVER_ENV
ENV ALTV_HOST=$ALTV_HOST
ENV ALTV_USE_ENV_CONFIG=$ALTV_USE_ENV_CONFIG
ENV ALTV_NAME=$ALTV_NAME
ENV ALTV_PORT=$ALTV_PORT
ENV ALTV_PASSWORD=$ALTV_PASSWORD
ENV ALTV_ANNOUNCE=$ALTV_ANNOUNCE
ENV ALTV_DEBUG=$ALTV_DEBUG
ENV ALTV_MODULES=$ALTV_MODULES
ENV ALTV_RESOURCES=$ALTV_RESOURCES
ENV ALTV_TOKEN=$ALTV_TOKEN
ENV VITE_CDN_URL=$VITE_CDN_URL

# S3 arguments for CDN sync
ARG S3_ACCESS_KEY
ARG S3_REGION
ARG S3_HOST_BASE
ARG S3_HOST_BUCKET
ARG S3_SECRET_KEY
ARG S3_WEBSITE_ENDPOINT

ENV S3_ACCESS_KEY=$S3_ACCESS_KEY
ENV S3_REGION=$S3_REGION
ENV S3_HOST_BASE=$S3_HOST_BASE
ENV S3_HOST_BUCKET=$S3_HOST_BUCKET
ENV S3_SECRET_KEY=$S3_SECRET_KEY
ENV S3_WEBSITE_ENDPOINT=$S3_WEBSITE_ENDPOINT

# Common setup stage
FROM deps as common-setup
COPY ./docker-scripts /root/setup
COPY ./altv /altv

# Setup initial environment with better error handling
RUN set -e && \
    cd /root/setup && \
    echo "Installing setup dependencies..." && \
    bun install --no-cache && \
    cd /altv && \
    echo "Running setup script..." && \
    bun run /root/setup/server.js && \
    echo "Installing altv-pkg..." && \
    /root/.bun/bin/bunx --bun altv-pkg@latest $ALTV_BRANCH && \
    echo "Making files executable..." && \
    chmod +x altv-server altv-crash-handler && \
    echo "Installing project dependencies..." && \
    bun install --no-cache && \
    echo "Generating Prisma client..." && \
    bun run prisma:generate && \
    echo "Cleaning up..." && \
    rm -rf ~/.bun/install/cache

# Generate .s3cfg for CDN sync
RUN echo "[default]\n\
  access_key = ${S3_ACCESS_KEY}\n\
  access_token =\n\
  add_encoding_exts =\n\
  add_headers =\n\
  bucket_location = ${S3_REGION}\n\
  ca_certs_file =\n\
  cache_file =\n\
  check_ssl_certificate = True\n\
  check_ssl_hostname = True\n\
  cloudfront_host = cloudfront.amazonaws.com\n\
  connection_max_age = 5\n\
  connection_pooling = True\n\
  content_disposition = \n\
  content_type = \n\
  default_mime_type = binary/octet-stream\n\
  delay_updates = False\n\
  delete_after = False\n\
  delete_after_fetch = False\n\
  delete_removed = False\n\
  dry_run = False\n\
  enable_multipart = True\n\
  encoding = UTF-8\n\
  encrypt = False\n\
  expiry_date = \n\
  expiry_days = \n\
  expiry_prefix = \n\
  follow_symlinks = False\n\
  force = False\n\
  get_continue = False\n\
  gpg_command = /usr/bin/gpg\n\
  gpg_decrypt = %(gpg_command)s -d --verbose --no-use-agent --batch --yes --passphrase-fd %(passphrase_fd)s -o %(output_file)s %(input_file)s\n\
  gpg_encrypt = %(gpg_command)s -c --verbose --no-use-agent --batch --yes --passphrase-fd %(passphrase_fd)s -o %(output_file)s %(input_file)s\n\
  gpg_passphrase = 5284691367\n\
  guess_mime_type = True\n\
  host_base = ${S3_HOST_BASE}\n\
  host_bucket = ${S3_HOST_BUCKET}\n\
  human_readable_sizes = False\n\
  invalidate_default_index_on_cf = False\n\
  invalidate_default_index_root_on_cf = True\n\
  invalidate_on_cf = False\n\
  kms_key = \n\
  limit = -1\n\
  limitrate = 0\n\
  list_md5 = False\n\
  log_target_prefix = \n\
  long_listing = False\n\
  max_delete = -1\n\
  mime_type = \n\
  multipart_chunk_size_mb = 15\n\
  multipart_copy_chunk_size_mb = 1024\n\
  multipart_max_chunks = 10000\n\
  preserve_attrs = True\n\
  progress_meter = True\n\
  proxy_host = \n\
  proxy_port = 0\n\
  public_url_use_https = False\n\
  put_continue = False\n\
  recursive = False\n\
  recv_chunk = 65536\n\
  reduced_redundancy = False\n\
  requester_pays = False\n\
  restore_days = 1\n\
  restore_priority = Standard\n\
  secret_key = ${S3_SECRET_KEY}\n\
  send_chunk = 65536\n\
  server_side_encryption = False\n\
  signature_v2 = False\n\
  signurl_use_https = False\n\
  simpledb_host = sdb.amazonaws.com\n\
  skip_existing = False\n\
  socket_timeout = 300\n\
  ssl_client_cert_file = \n\
  ssl_client_key_file = \n\
  stats = False\n\
  stop_on_error = False\n\
  storage_class = \n\
  throttle_max = 100\n\
  upload_id = \n\
  urlencoding_mode = normal\n\
  use_http_expect = False\n\
  use_https = True\n\
  use_mime_magic = True\n\
  verbosity = WARNING\n\
  website_endpoint = ${S3_WEBSITE_ENDPOINT}\n\
  website_error = \n\
  website_index = index.html\n\
  " > /root/.s3cfg

# Stage for building main project (first in sequence)
FROM common-setup as build-main
RUN set -e && \
    echo "Building main project..." && \
    cd /altv && \
    bun run build

# Stage for building webview (runs after build-main)
FROM build-main as build-webview
RUN set -e && \
    echo "Building webview..." && \
    cd /altv/src/webview && \
    echo "Installing webview dependencies..." && \
    bun install --no-cache && \
    echo "Cleaning bun cache..." && \
    rm -rf ~/.bun/install/cache && \
    echo "Running webview build..." && \
    bun --bun run build-only && \
    echo "Cleaning node_modules cache..." && \
    rm -rf node_modules/.cache

# Stage for database migration (runs after build-webview)
FROM build-webview as db-migration
RUN set -e && \
    echo "Running database migrations..." && \
    cd /altv && \
    bun run migration:run

# Final stage to combine all builds
FROM deps as runtime
WORKDIR /altv

# Copy the base setup from common-setup
COPY --from=common-setup /altv /altv/
COPY --from=common-setup /root/.s3cfg /root/.s3cfg

# Copy the main build artifacts - these will overwrite any duplicates
COPY --from=build-main /altv/resources /altv/resources/
COPY --from=build-main /altv/package.json /altv/

# Copy and set up webview assets - now using the db-migration stage which has everything
COPY --from=db-migration /altv/src/webview/dist /altv/src/webview/dist/

# Create webview directory and move index.html
RUN mkdir -p /altv/resources/main/client/webview && \
    mv /altv/src/webview/dist/index.html /altv/resources/main/client/webview/

# Now sync webview assets to CDN after we have all the files
RUN cd /altv/src/webview && \
    s3cmd sync dist/ s3://altv-rift/webview-assets/ --acl-public --delete-removed --no-mime-magic --guess-mime-type

# Cleanup
RUN rm -rf /altv/src && \
    # Don't remove node_modules completely, since we need the dependencies
    rm -rf /altv/node_modules/.cache

# Expose necessary ports
EXPOSE 7788/udp 7788/tcp 7799/udp 7790/tcp

ENTRYPOINT ["/altv/altv-server"]
